<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CyberpunkModTranslator.Core</RootNamespace>
    <AssemblyName>CyberpunkModTranslator.Core</AssemblyName>
    <!-- CA1416 : les appels au registre Windows sont proteges par OperatingSystem.IsWindows() -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <!-- Langues de l'interface integrees (secours si le dossier lang est absent) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\lang\*.json" LogicalName="lang/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
